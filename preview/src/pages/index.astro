---
import Preview from '../layouts/Preview.astro';
import Specimens from '../components/Specimens.astro';
import GlassBar from '@robyrew/ui/components/GlassBar.astro';
import GlassSheet from '@robyrew/ui/components/GlassSheet.astro';
import GlassPalette from '@robyrew/ui/components/GlassPalette.astro';
import GlassHud from '@robyrew/ui/components/GlassHud.astro';
import GlassPlayer from '@robyrew/ui/components/GlassPlayer.astro';
import GlassAuthCard from '@robyrew/ui/components/GlassAuthCard.astro';
import GlassFooter from '@robyrew/ui/components/GlassFooter.astro';
import { artDusk } from '../lib/art';
import pkg from '@robyrew/ui/package.json';
---
<Preview title={`@robyrew/ui ${pkg.version} — preview`}>
  <div class="pv-float rw-scroll-edge">
    <GlassBar
      links={[
        { label: 'Themes', href: '#themes', current: true },
        { label: 'Behaviour', href: '#behaviour' },
        { label: 'Environment', href: '#environment' },
        { label: 'Devices', href: '/devices' },
      ]}
      hint="⌘K"
      collapse="lg"
    >
      <span slot="brand" class="pv-word">rw<span>/ui</span></span>
      <div slot="end" class="rw-seg" role="radiogroup" aria-label="Appearance" data-rw-seg="select">
        <span class="rw-seg__thumb" aria-hidden="true"></span>
        <button class="rw-seg__item rw-gl" type="button" role="radio" aria-checked="true" data-rw-theme-set="system" aria-label="System" title="System">◐</button>
        <button class="rw-seg__item rw-gl" type="button" role="radio" aria-checked="false" data-rw-theme-set="light" aria-label="Light" title="Light">☀</button>
        <button class="rw-seg__item rw-gl" type="button" role="radio" aria-checked="false" data-rw-theme-set="dark" aria-label="Dark" title="Dark">☾</button>
      </div>
      <div slot="menu" class="rw-seg" role="radiogroup" aria-label="Appearance" data-rw-seg="select">
        <span class="rw-seg__thumb" aria-hidden="true"></span>
        <button class="rw-seg__item rw-gl" type="button" role="radio" aria-checked="true" data-rw-theme-set="system" aria-label="System">◐</button>
        <button class="rw-seg__item rw-gl" type="button" role="radio" aria-checked="false" data-rw-theme-set="light" aria-label="Light">☀</button>
        <button class="rw-seg__item rw-gl" type="button" role="radio" aria-checked="false" data-rw-theme-set="dark" aria-label="Dark">☾</button>
      </div>
    </GlassBar>
  </div>

  <main class="pv-wrap">
    <header class="pv-intro">
      <span class="pv-kicker">@robyrew/ui {pkg.version}</span>
      <h1>Every component and control, in both themes.</h1>
      <p>
        The two panes below pin <code>data-theme</code> to dark and light, so both render side by side
        whatever this page is set to; the switch in the bar sets the page itself. The contrast tables are
        measured from the live styles in this browser. Resize the window or open <a href="/devices" style="color: var(--accent)">Devices</a> for
        watch, phone and iPad frames.
      </p>
    </header>

    <section class="pv-section" id="themes" aria-label="Themes">
      <div class="pv-panes">
        <Specimens theme="dark" />
        <Specimens theme="light" />
      </div>
    </section>

    <section class="pv-section" id="behaviour">
      <h2>Behaviour</h2>
      <p>These follow the page theme. Each one works without its script in a current browser; the script adds gestures, keyboard handling, timers and exit animations.</p>
      <div class="pv-grid pv-grid--wide">
        <div class="rw-card pv-card">
          <h3>Sheet</h3>
          <p>Bottom-docked under 48rem (drag the handle down), a centred form sheet above. Escape, the ✕, a backdrop click or the action close it.</p>
          <div class="rw-actions">
            <button class="rw-btn rw-btn--primary" type="button" commandfor="pv-sheet" command="show-modal">Open sheet</button>
            <button class="rw-btn" type="button" commandfor="pv-sheet-long" command="show-modal">Long sheet</button>
          </div>
          <p class="rw-hint" data-sheet-result>returnValue: —</p>
        </div>
        <div class="rw-card pv-card">
          <h3>Palette</h3>
          <p>⌘K or Ctrl+K toggles it. Type to filter (try “cafe”), arrows to move, Enter to go, Escape to clear and then close.</p>
          <div class="rw-actions">
            <button class="rw-btn rw-btn--primary" type="button" commandfor="pv-palette" command="show-modal">Open palette</button>
          </div>
          <p class="rw-hint" data-pal-result>rw:select: —</p>
        </div>
        <div class="rw-card pv-card">
          <h3>Toasts</h3>
          <p>Raised with toast(). Hover or focus pauses the timer; on touch, swipe one sideways.</p>
          <div class="rw-actions">
            <button class="rw-btn" type="button" data-toast="ok">Success</button>
            <button class="rw-btn" type="button" data-toast="warn">Warning</button>
            <button class="rw-btn" type="button" data-toast="error">Error</button>
            <button class="rw-btn" type="button" data-toast="info">Info</button>
            <button class="rw-btn" type="button" data-toast="bottom">Bottom</button>
          </div>
        </div>
        <div class="rw-card pv-card">
          <h3>HUD</h3>
          <p>showHud() raises the overlay and lets it fade after a moment of quiet. The arrow keys work while a button here has focus.</p>
          <div class="rw-actions" data-hud-keys>
            <button class="rw-btn" type="button" data-hud="-10" aria-label="Volume down">−</button>
            <button class="rw-btn" type="button" data-hud="10" aria-label="Volume up">+</button>
          </div>
        </div>
        <div class="rw-card pv-card">
          <h3>Tabs</h3>
          <div class="rw-seg" role="tablist" aria-label="Plan" data-rw-seg="select">
            <span class="rw-seg__thumb" aria-hidden="true"></span>
            <button class="rw-seg__item" type="button" role="tab" id="pv-tab-a" aria-selected="true" aria-controls="pv-panel-a">Free</button>
            <button class="rw-seg__item" type="button" role="tab" id="pv-tab-b" aria-selected="false" aria-controls="pv-panel-b">Pro</button>
            <button class="rw-seg__item" type="button" role="tab" id="pv-tab-c" aria-selected="false" aria-controls="pv-panel-c">Team</button>
          </div>
          <div class="pv-tabpanel" role="tabpanel" id="pv-panel-a" aria-labelledby="pv-tab-a">One site, the shared design system, community support.</div>
          <div class="pv-tabpanel" role="tabpanel" id="pv-panel-b" aria-labelledby="pv-tab-b" hidden>Everything in Free, custom domains, priority builds.</div>
          <div class="pv-tabpanel" role="tabpanel" id="pv-panel-c" aria-labelledby="pv-tab-c" hidden>Everything in Pro, shared sign-in through Logto, audit log.</div>
        </div>
      </div>

      <div class="pv-stage rw-bp-dusk">
        <audio id="pv-audio" preload="metadata"></audio>
        <GlassPlayer media="#pv-audio" seekable title="Generated tone" subtitle="Drives a real <audio> · Media Session" artwork={artDusk} progress={0} playing={false} theme="dark" />
        <div class="pv-grid pv-grid--wide">
          <GlassAuthCard title="Busy state" subtitle="Submits to this page with GET; the button holds a spinner until it loads." action="Sign in" busyLabel="Signing in…" method="get" formAction="/" theme="dark">
            <label>Workspace <input type="text" name="signed-in" placeholder="demo" autocomplete="off" required /></label>
          </GlassAuthCard>
        </div>
      </div>
    </section>

    <section class="pv-section" id="environment">
      <h2>Environment</h2>
      <p>What this browser reports, live. Change the window size, the OS appearance, reduced motion or increased contrast and watch the values follow.</p>
      <dl class="pv-env" data-env></dl>
    </section>

    <GlassFooter
      groups={[
        { title: 'Package', links: [{ label: 'Repository', href: 'https://github.com/RobyRew/ui', external: true }, { label: 'web-config', href: 'https://github.com/RobyRew/web-config', external: true }] },
        { title: 'Preview', links: [{ label: 'Themes', href: '#themes' }, { label: 'Behaviour', href: '#behaviour' }, { label: 'Devices', href: '/devices' }] },
        { title: 'Rules', links: [{ label: 'Glass floats, content is opaque', href: '#themes' }, { label: 'WCAG AA text', href: '#themes' }] },
      ]}
      note={`@robyrew/ui ${pkg.version} · Apache-2.0`}
    />
  </main>

  <GlassSheet modal id="pv-sheet" title="Share link" action="Copy link">
    <p>Anyone with the link can view this page. The action button closes the sheet with returnValue “confirm”; the ✕, Escape, a drag or a backdrop click give “cancel”.</p>
    <label class="rw-label" for="pv-share" style="margin-top: .75rem">Link</label>
    <input class="rw-field" id="pv-share" value="https://example.com/s/4f9a" readonly />
  </GlassSheet>
  <GlassSheet modal id="pv-sheet-long" size="large" title="Release notes" action="Done">
    {Array.from({ length: 14 }, (_, i) => (
      <p style="margin-bottom: .75rem">Paragraph {i + 1}. The body scrolls inside the sheet, the page behind it does not, and the scroll stops at the edge instead of chaining to the page.</p>
    ))}
  </GlassSheet>
  <GlassPalette
    modal
    id="pv-palette"
    placeholder="Search the preview…"
    rows={[
      { glyph: '◐', label: 'Themes', href: '#themes', group: 'Sections', keywords: 'dark light palette' },
      { glyph: '⚙', label: 'Behaviour', href: '#behaviour', group: 'Sections', keywords: 'sheet toast hud' },
      { glyph: '⌁', label: 'Environment', href: '#environment', group: 'Sections', keywords: 'media query pointer' },
      { glyph: '⧉', label: 'Devices', href: '/devices', group: 'Pages', keywords: 'watch phone ipad' },
      { glyph: '☕', label: 'Café menu', href: '#behaviour', group: 'Examples', keywords: 'coffee', value: 'cafe' },
      { glyph: '♪', label: 'Play the tone', href: '#behaviour', group: 'Examples', value: 'play' },
    ]}
  />
  <GlassHud overlay id="pv-hud" glyph="♪" caption="VOLUME 50" value={50} />
</Preview>

<script>
  import { toast, showHud, onReady } from '@robyrew/ui/behaviors.js';

  /* ── Toasts ── */
  const SAMPLES = {
    ok: { title: 'Saved.', detail: 'notes.md · 2 KB', tone: 'ok', action: { label: 'Undo', onClick: () => toast({ title: 'Restored.', tone: 'info' }) } },
    warn: { title: 'Storage almost full.', detail: '92% used', tone: 'warn' },
    error: { title: 'Upload failed.', detail: 'The connection dropped.', tone: 'error', timeout: 0 },
    info: { title: 'Two devices signed in.', tone: 'info' },
    bottom: { title: 'Copied to clipboard.', tone: 'ok', placement: 'bottom' },
  } as const;
  document.addEventListener('click', (e) => {
    const b = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-toast]') : null;
    const s = b && SAMPLES[b.dataset.toast as keyof typeof SAMPLES];
    if (s) toast({ ...s });
  });

  /* ── HUD ── */
  let level = 50;
  const bump = (d: number) => {
    level = Math.min(100, Math.max(0, level + d));
    showHud('pv-hud', { value: level, caption: `VOLUME ${level}` });
  };
  document.addEventListener('click', (e) => {
    const b = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-hud]') : null;
    if (b) bump(Number(b.dataset.hud));
  });
  document.querySelector('[data-hud-keys]')?.addEventListener('keydown', (e) => {
    const k = (e as KeyboardEvent).key;
    if (k === 'ArrowUp' || k === 'ArrowRight') { e.preventDefault(); bump(5); }
    if (k === 'ArrowDown' || k === 'ArrowLeft') { e.preventDefault(); bump(-5); }
  });

  /* ── Chips toggle ── */
  document.addEventListener('click', (e) => {
    const chip = e.target instanceof Element ? e.target.closest<HTMLElement>('[data-chips] .rw-chip') : null;
    if (chip) chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
  });

  /* ── Sheet and palette results ── */
  for (const id of ['pv-sheet', 'pv-sheet-long']) {
    const d = document.getElementById(id) as HTMLDialogElement | null;
    d?.addEventListener('close', () => {
      const out = document.querySelector('[data-sheet-result]');
      if (out) out.textContent = `returnValue: “${d.returnValue || '(empty)'}” from #${id}`;
    });
  }
  document.addEventListener('rw:select', (e) => {
    const out = document.querySelector('[data-pal-result]');
    const v = (e as CustomEvent<{ value: string | null }>).detail.value;
    if (out) out.textContent = `rw:select: “${v ?? ''}”`;
    if (v === 'play') (document.getElementById('pv-audio') as HTMLAudioElement | null)?.play().catch(() => {});
  });

  /* ── A generated tone for the media-bound player: 24 s, fades in and out. ── */
  function tone(seconds = 24, rate = 22050): Blob {
    const n = seconds * rate;
    const buf = new ArrayBuffer(44 + n * 2);
    const v = new DataView(buf);
    const w = (o: number, s: string) => { for (let i = 0; i < s.length; i++) v.setUint8(o + i, s.charCodeAt(i)); };
    w(0, 'RIFF'); v.setUint32(4, 36 + n * 2, true); w(8, 'WAVE'); w(12, 'fmt ');
    v.setUint32(16, 16, true); v.setUint16(20, 1, true); v.setUint16(22, 1, true);
    v.setUint32(24, rate, true); v.setUint32(28, rate * 2, true); v.setUint16(32, 2, true); v.setUint16(34, 16, true);
    w(36, 'data'); v.setUint32(40, n * 2, true);
    for (let i = 0; i < n; i++) {
      const t = i / rate;
      const env = Math.min(1, t * 1.5, (seconds - t) * 1.5) * 0.1 * (0.7 + 0.3 * Math.sin(2 * Math.PI * 0.25 * t));
      const s = (Math.sin(2 * Math.PI * 220 * t) + 0.6 * Math.sin(2 * Math.PI * 277.18 * t) + 0.4 * Math.sin(2 * Math.PI * 329.63 * t)) / 2;
      v.setInt16(44 + i * 2, Math.max(-1, Math.min(1, s * env)) * 32767, true);
    }
    return new Blob([buf], { type: 'audio/wav' });
  }
  const audio = document.getElementById('pv-audio') as HTMLAudioElement | null;
  if (audio && !audio.src) audio.src = URL.createObjectURL(tone());

  /* ── Contrast, measured from the live styles of each pane ── */
  type RGB = [number, number, number, number];
  const parse = (c: string): RGB => {
    const m = c.match(/rgba?\(([^)]+)\)/);
    if (!m) return [0, 0, 0, 1];
    const p = m[1]!.split(/[\s,/]+/).filter(Boolean).map(Number);
    return [p[0] ?? 0, p[1] ?? 0, p[2] ?? 0, p[3] ?? 1];
  };
  const lum = ([r, g, b]: RGB) => {
    const f = (x: number) => { const s = x / 255; return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; };
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);
  };
  const over = (fg: RGB, bg: RGB): RGB => [0, 1, 2].map((i) => fg[i]! * fg[3] + bg[i]! * (1 - fg[3])).concat(1) as RGB;
  const ratio = (a: RGB, b: RGB) => { const x = lum(a), y = lum(b); return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };

  function measure(pane: HTMLElement) {
    const probe = document.createElement('i');
    probe.style.display = 'none';
    pane.append(probe);
    const tok = (name: string) => { probe.style.color = `var(--${name})`; return parse(getComputedStyle(probe).color); };
    const ground = tok('ground'), panel = tok('panel');
    const glassEl = pane.querySelector('.rw-glass');
    const glass = glassEl ? over(parse(getComputedStyle(glassEl).backgroundColor), ground) : ground;
    const rows: [string, RGB, RGB, number][] = [
      ['ink / ground', tok('ink'), ground, 4.5],
      ['ink-2 / panel', tok('ink-2'), panel, 4.5],
      ['ink-3 / ground', tok('ink-3'), ground, 4.5],
      ['accent / ground', tok('accent'), ground, 4.5],
      ['on-accent / accent', tok('on-accent'), tok('accent'), 4.5],
      ['g-ink-mute / glass', tok('g-ink-mute'), glass, 4.5],
      ['danger / panel', tok('rw-danger'), panel, 4.5],
      ['panel / ground (surface step)', panel, ground, 0],
    ];
    probe.remove();
    const body = pane.querySelector('[data-contrast] tbody');
    if (!body) return;
    body.replaceChildren(...rows.map(([label, fg, bg, need]) => {
      const tr = document.createElement('tr');
      const r = ratio(over(fg, bg), bg);
      const pass = need === 0 || r >= need;
      const verdict = need === 0 ? 'info' : pass ? 'AA' : 'fails';
      tr.innerHTML = `<td></td><td>${r.toFixed(2)}:1</td><td><span class="rw-badge ${need === 0 ? '' : pass ? 'rw-badge--ok' : 'rw-badge--danger'}">${verdict}</span></td>`;
      tr.firstElementChild!.textContent = label;
      return tr;
    }));
  }

  /* ── Environment readout ── */
  const QUERIES: [string, string[]][] = [
    ['pointer', ['coarse', 'fine', 'none']],
    ['hover', ['hover', 'none']],
    ['prefers-color-scheme', ['dark', 'light']],
    ['prefers-reduced-motion', ['reduce', 'no-preference']],
    ['prefers-contrast', ['more', 'less', 'custom', 'no-preference']],
    ['prefers-reduced-transparency', ['reduce', 'no-preference']],
    ['forced-colors', ['active', 'none']],
  ];
  function env() {
    const dl = document.querySelector('[data-env]');
    if (!dl) return;
    const items: [string, string][] = [
      ['viewport', `${innerWidth} × ${innerHeight}`],
      ['device pixel ratio', String(devicePixelRatio)],
      ['data-theme', document.documentElement.dataset.theme ?? '(none)'],
      ...QUERIES.map(([q, vals]) => [q, vals.find((v) => matchMedia(`(${q}: ${v})`).matches) ?? 'unsupported'] as [string, string]),
    ];
    dl.replaceChildren(...items.map(([k, v]) => {
      const d = document.createElement('div');
      const dt = document.createElement('dt'); dt.textContent = k;
      const dd = document.createElement('dd'); dd.textContent = v;
      d.append(dt, dd);
      return d;
    }));
  }

  onReady(() => {
    for (const pane of document.querySelectorAll<HTMLElement>('.pv-pane')) measure(pane);
    env();
    if (new URLSearchParams(location.search).has('signed-in')) toast({ title: 'Signed in.', detail: '(demo — nothing was sent anywhere)', tone: 'ok' });
  });
  addEventListener('resize', env);
  document.addEventListener('rw:themechange', () => requestAnimationFrame(env));
  new MutationObserver(env).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  for (const [q, vals] of QUERIES) for (const v of vals) matchMedia(`(${q}: ${v})`).addEventListener?.('change', env);
</script>
