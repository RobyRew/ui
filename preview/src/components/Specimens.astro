---
/** Every control and every glass format, rendered inside one theme pane. The
 *  pane carries data-theme, so all of it resolves against that theme's tokens
 *  whatever the page itself is set to. */
import GlassBar from '@robyrew/ui/components/GlassBar.astro';
import GlassPalette from '@robyrew/ui/components/GlassPalette.astro';
import GlassHud from '@robyrew/ui/components/GlassHud.astro';
import GlassPlayer from '@robyrew/ui/components/GlassPlayer.astro';
import GlassTile from '@robyrew/ui/components/GlassTile.astro';
import GlassList from '@robyrew/ui/components/GlassList.astro';
import GlassSheet from '@robyrew/ui/components/GlassSheet.astro';
import GlassRail from '@robyrew/ui/components/GlassRail.astro';
import GlassAuthCard from '@robyrew/ui/components/GlassAuthCard.astro';
import GlassToast from '@robyrew/ui/components/GlassToast.astro';
import GlassFooter from '@robyrew/ui/components/GlassFooter.astro';
import { artDusk, artSea } from '../lib/art';

interface Props { theme: 'light' | 'dark' }
const { theme } = Astro.props;
const p = `pv-${theme}`;
const backdrop = theme === 'dark' ? 'rw-bp-aurora' : 'rw-bp-daylight';
const tokens = ['ground', 'ground-2', 'panel', 'hair', 'ink', 'ink-2', 'ink-3', 'accent', 'on-accent', 'rw-ok', 'rw-warn', 'rw-danger'];
const links = [
  { label: 'Work', href: '#controls', current: true },
  { label: 'Notes', href: '#glass' },
  { label: 'Lab', href: '#behaviour' },
  { label: 'About', href: '#environment' },
];
const rail = [
  { glyph: '⌂', label: 'Home', href: '#', current: true },
  { glyph: '⌕', label: 'Search', href: '#' },
  { glyph: '♪', label: 'Music', href: '#' },
  { glyph: '—', label: '', href: '' },
  { glyph: '⚙', label: 'Settings', href: '#' },
];
---
<section class="pv-pane" data-theme={theme} aria-labelledby={`${p}-h`}>
  <header class="pv-pane__head">
    <h2 id={`${p}-h`}>{theme === 'dark' ? 'Dark' : 'Light'}</h2>
    <span class="rw-badge">data-theme="{theme}"</span>
  </header>

  <h3 class="pv-h">Palette</h3>
  <div class="pv-swatches">
    {tokens.map((t) => <div class="pv-sw"><i data-token={t}></i><code>--{t}</code></div>)}
  </div>
  <table class="pv-contrast" data-contrast>
    <caption class="rw-sr-only">Contrast of the {theme} palette, measured in the browser</caption>
    <thead><tr><th scope="col">Pair</th><th scope="col">Ratio</th><th scope="col">WCAG</th></tr></thead>
    <tbody></tbody>
  </table>

  <h3 class="pv-h">Controls</h3>
  <div class="rw-card pv-card">
    <h3>Buttons</h3>
    <div class="rw-actions">
      <button class="rw-btn rw-btn--primary" type="button">Primary</button>
      <button class="rw-btn" type="button">Default</button>
      <button class="rw-btn rw-btn--plain" type="button">Plain</button>
      <button class="rw-btn rw-btn--danger" type="button">Delete</button>
      <button class="rw-btn" type="button" disabled>Disabled</button>
      <button class="rw-btn" type="button" aria-busy="true">Saving</button>
      <button class="rw-btn rw-btn--icon rw-gl" type="button" aria-label="Close">✕</button>
    </div>
    <div class="rw-actions">
      <button class="rw-btn rw-btn--sm" type="button">Small</button>
      <button class="rw-btn" type="button">Regular</button>
      <button class="rw-btn rw-btn--lg rw-btn--primary" type="button">Large</button>
    </div>
    <div class="rw-actions rw-actions--stretch">
      <button class="rw-btn" type="button">Cancel</button>
      <button class="rw-btn rw-btn--primary" type="button">Continue</button>
    </div>
  </div>

  <div class="rw-card pv-card">
    <h3>Fields</h3>
    <div class="pv-fields">
      <div>
        <label class="rw-label" for={`${p}-name`}>Name</label>
        <input class="rw-field" id={`${p}-name`} placeholder="Ada Lovelace" autocomplete="name" />
      </div>
      <div>
        <label class="rw-label" for={`${p}-q`}>Search</label>
        <div class="rw-field-wrap">
          <span class="rw-field-icon rw-gl" aria-hidden="true">⌕</span>
          <input class="rw-field" id={`${p}-q`} type="search" placeholder="Find a note" />
        </div>
      </div>
      <div>
        <label class="rw-label" for={`${p}-mail`}>Email</label>
        <input class="rw-field" id={`${p}-mail`} type="email" value="not-an-email" aria-invalid="true" aria-describedby={`${p}-mail-h`} />
        <p class="rw-hint rw-hint--error" id={`${p}-mail-h`}>Enter an address like name@example.com.</p>
      </div>
      <div>
        <label class="rw-label" for={`${p}-sel`}>Language</label>
        <select class="rw-field" id={`${p}-sel`}>
          <option>English</option><option>Español</option><option>Català</option><option>Română</option>
        </select>
      </div>
      <div>
        <label class="rw-label" for={`${p}-off`}>Disabled</label>
        <input class="rw-field" id={`${p}-off`} value="Read only" disabled />
      </div>
      <div>
        <label class="rw-label" for={`${p}-note`}>Note</label>
        <textarea class="rw-field rw-field--grow" id={`${p}-note`} rows="2" placeholder="Grows as you type"></textarea>
        <p class="rw-hint">Hints sit under the field.</p>
      </div>
    </div>
  </div>

  <div class="rw-card pv-card">
    <h3>Segments, chips, badges</h3>
    <div class="rw-seg" role="tablist" aria-label="View" data-rw-seg="select">
      <span class="rw-seg__thumb" aria-hidden="true"></span>
      <button class="rw-seg__item" type="button" role="tab" aria-selected="true">Day</button>
      <button class="rw-seg__item" type="button" role="tab" aria-selected="false">Week</button>
      <button class="rw-seg__item" type="button" role="tab" aria-selected="false">Month</button>
      <button class="rw-seg__item" type="button" role="tab" aria-selected="false">Year</button>
    </div>
    <div class="rw-seg" role="radiogroup" aria-label="Density" data-rw-seg="select">
      <button class="rw-seg__item" type="button" role="radio" aria-checked="false">Compact</button>
      <button class="rw-seg__item" type="button" role="radio" aria-checked="true">Regular</button>
    </div>
    <div class="pv-row" data-chips>
      <button class="rw-chip" type="button" aria-pressed="true">All</button>
      <button class="rw-chip" type="button" aria-pressed="false">Unread</button>
      <button class="rw-chip" type="button" aria-pressed="false">Flagged ⚑</button>
    </div>
    <div class="pv-row">
      <span class="rw-badge">Draft</span>
      <span class="rw-badge rw-badge--accent">New</span>
      <span class="rw-badge rw-badge--ok">Live</span>
      <span class="rw-badge rw-badge--warn">Pending</span>
      <span class="rw-badge rw-badge--danger">Failed</span>
    </div>
  </div>

  <div class="rw-card pv-card">
    <h3>Switches, slider, progress</h3>
    <label class="pv-label-row">Wi-Fi <input class="rw-switch" type="checkbox" checked /></label>
    <label class="pv-label-row">Bluetooth <input class="rw-switch" type="checkbox" /></label>
    <label class="pv-label-row">Airplane mode <input class="rw-switch" type="checkbox" disabled /></label>
    <label class="pv-label-row">Volume <input class="rw-range" type="range" min="0" max="100" value="40" style="max-width: 12rem" /></label>
    <progress class="rw-progress" max="100" value="62" aria-label="Upload"></progress>
    <progress class="rw-progress" aria-label="Loading"></progress>
    <div class="pv-row"><span class="rw-spinner" role="status" aria-label="Loading"></span><span class="rw-hint" style="margin: 0">Spinner in the current colour</span></div>
  </div>

  <div class="rw-card">
    <div class="rw-card__rows">
      <a class="rw-card__row" href="#controls">Account <span style="margin-inline-start:auto" class="rw-gl" aria-hidden="true">›</span></a>
      <button class="rw-card__row" type="button">Privacy <span style="margin-inline-start:auto;color:var(--ink-3)">On</span></button>
      <label class="rw-card__row">Notifications <input class="rw-switch" type="checkbox" checked style="margin-inline-start:auto" /></label>
    </div>
  </div>
  <a class="rw-card rw-card--interactive pv-card" href="#glass">
    <h3>Interactive card</h3>
    <p>Lifts under a pointer, presses under a finger, rings under the keyboard.</p>
  </a>

  <h3 class="pv-h">Glass</h3>
  <div class:list={['pv-stage', backdrop]}>
    <GlassBar links={links} action={{ label: 'Contact', href: '#behaviour' }} hint="⌘K" />
    <GlassBar links={links} action={{ label: 'Get the app', href: '#', primary: true }} collapse="always">
      <span slot="brand" class="pv-word">rw<span>/ui</span></span>
    </GlassBar>
    <div class="pv-grid">
      <GlassTile label="Visitors · 7d" value="1 284" delta="18.4%" spark={[38, 52, 44, 66, 58, 79, 94]} />
      <GlassTile label="Errors · 24h" value="3" delta="2" trend="down" spark={[9, 7, 8, 4, 6, 3, 3]} href="#glass" />
      <GlassHud glyph="♪" caption="VOLUME" value={62} />
      <GlassList rows={[
        { glyph: '⏻', label: 'Exit node', value: 'On', href: '#' },
        { glyph: '⌁', label: 'DNS filtering', value: 'Kids', href: '#', detail: 'Schedule 21:00 – 07:00' },
        { glyph: '⚿', label: 'Passkeys', value: '3', current: true, href: '#' },
        { label: 'Docs', href: 'https://example.com', external: true },
      ]} />
    </div>
    <div class="pv-grid pv-grid--wide">
      <GlassPalette rows={[
        { glyph: '⌂', label: 'Home', tail: '↵', href: '#controls', current: true },
        { glyph: '⧉', label: 'Duplicate note', tail: '⌘D', href: '#glass' },
        { glyph: '◐', label: 'Toggle appearance', tail: '⌘⇧L', href: '#behaviour' },
        { glyph: '⚑', label: 'Report a problem', href: '#environment' },
      ]} />
      <GlassAuthCard title="Sign in" action="Continue" alt="Passkeys work too." formAction="#" method="get">
        <label>Email <input type="email" name="email" placeholder="you@example.com" autocomplete="email" required /></label>
        <label>Password <input type="password" name="password" placeholder="At least 8 characters" minlength="8" autocomplete="current-password" required /></label>
      </GlassAuthCard>
    </div>
    <GlassPlayer title="Evening Light" subtitle="Generated tone · RobyRew" progress={38} artwork={artDusk} />
    <GlassPlayer title="Low Tide, a much longer title that has to truncate" subtitle="Seekable" progress={64} artwork={artSea} seekable playing={false} />
    <GlassToast title="Deployed." detail="portfolio · 15s" action={{ label: 'View log', href: '#' }} />
    <GlassToast title="Certificate renews in 6 days." tone="warn" />
    <GlassToast title="Build failed." detail="exit code 1" tone="error" action={{ label: 'Retry', href: '#' }} />
    <GlassToast title="Two devices signed in." tone="info" dismissible={false} />
    <div class="pv-rails">
      <GlassRail items={rail} />
      <GlassRail items={rail} labels />
      <GlassRail items={rail} orientation="horizontal" labels />
    </div>
    <GlassSheet title="Share" action="Done">
      Inline specimen of the sheet. The modal one is under Behaviour: on a phone it docks to the bottom
      edge and drags down to dismiss; on an iPad or a desktop it is a centred form sheet.
    </GlassSheet>
    <GlassFooter
      groups={[
        { title: 'Sites', links: [{ label: 'MapSwitch', href: '#' }, { label: 'Chat Converter', href: '#' }] },
        { title: 'Code', links: [{ label: 'GitHub', href: 'https://github.com/RobyRew', external: true }, { label: 'Licence', href: '#' }] },
        { title: 'About', links: [{ label: 'Privacy', href: '#' }, { label: 'Contact', href: '#' }] },
      ]}
      note="Apache-2.0"
    />
  </div>

  <h3 class="pv-h">Surface — the same formats, opaque, for content</h3>
  <div class="pv-grid">
    <GlassTile material="surface" label="Storage" value="61%" delta="4%" trend="flat" spark={[40, 44, 50, 52, 55, 58, 61]} />
    <GlassList material="surface" rows={[
      { glyph: '✓', label: 'Backups', value: 'Daily', href: '#' },
      { glyph: '⚑', label: 'Alerts', value: '2', href: '#' },
    ]} />
    <GlassPlayer material="surface" title="Podcast" subtitle="Episode 12" progress={20} artwork={artSea} playing={false} />
  </div>
</section>
