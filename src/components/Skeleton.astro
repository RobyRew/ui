---
/** Skeleton — placeholder shapes while content loads. One shape, or `lines`
 *  of text ending on a short one. Skeletons are aria-hidden; `label` adds a
 *  polite "Loading…" for screen readers (role="status"). Put aria-busy="true"
 *  on the region they stand in for. */
interface Props {
  lines?: number;
  shape?: 'text' | 'block' | 'circle';
  width?: 25 | 40 | 50 | 60 | 75 | 80 | 100;
  /** Block height: sm 3rem, md 6rem, lg 10rem. */
  height?: 'sm' | 'md' | 'lg';
  /** Circle size, as the avatar sizes. */
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  label?: string;
  class?: string;
}
const { lines = 1, shape = 'text', width, height, size, label, class: cls } = Astro.props;
const one = {
  'data-shape': shape === 'text' ? undefined : shape,
  'data-w': width,
  'data-h': shape === 'block' && height !== 'md' ? height : undefined,
  'data-size': shape === 'circle' && size !== 'md' ? size : undefined,
};
---
{lines > 1 ? (
  <div class:list={['rw-skeleton-lines', cls]} role={label ? 'status' : undefined}>
    {label && <span class="rw-sr-only">{label}</span>}
    {Array.from({ length: lines }, () => <span class="rw-skeleton" aria-hidden="true"></span>)}
  </div>
) : label ? (
  <div class={cls} role="status"><span class="rw-sr-only">{label}</span><span class="rw-skeleton" {...one} aria-hidden="true"></span></div>
) : (
  <span class:list={['rw-skeleton', cls]} {...one} aria-hidden="true"></span>
)}
