---
/** 08 · Rail — the vertical format. Glyph-only, so it survives at 56px wide.
 *
 *  `orientation="horizontal"` makes it a tab bar; "adaptive" is vertical from
 *  48rem of viewport width and a tab bar below it — the iPad sidebar / iPhone
 *  tab bar pair. `labels` shows each item's label under its glyph (otherwise
 *  the label is the accessible name and the tooltip). `dock` pins the tab-bar
 *  form to the bottom edge, above the home indicator. An item whose glyph is
 *  "—" is a divider.
 */
import './GlassRail.css';

export interface RailItem { glyph: string; label: string; href: string; current?: boolean }
interface Props {
  items: RailItem[];
  orientation?: 'vertical' | 'horizontal' | 'adaptive';
  labels?: boolean;
  dock?: boolean;
  /** Accessible name of the navigation landmark. */
  label?: string;
  theme?: 'light' | 'dark';
  material?: 'glass' | 'surface';
  class?: string;
}
const {
  items,
  orientation = 'vertical',
  labels = false,
  dock = false,
  label = 'Sections',
  theme,
  material = 'glass',
  class: cls = '',
} = Astro.props;
---
<nav
  class:list={[
    'rw-rail',
    material === 'surface' ? 'rw-surface' : 'rw-glass',
    orientation !== 'vertical' && `rw-rail--${orientation}`,
    { 'rw-rail--labels': labels, 'rw-rail--dock': dock },
    cls,
  ]}
  aria-label={label}
  data-theme={theme}
>
  {items.map((it) =>
    it.glyph === '—'
      ? <span class="rw-rail__div" aria-hidden="true"></span>
      : (
        <a href={it.href}
           title={labels ? undefined : it.label}
           aria-label={labels ? undefined : it.label}
           aria-current={it.current ? 'page' : undefined}
           class:list={['rw-rail__item', { 'is-current': it.current }]}>
          <span class="rw-rail__glyph rw-gl" aria-hidden={labels ? 'true' : undefined}>{it.glyph}</span>
          {labels && <span class="rw-rail__label">{it.label}</span>}
        </a>
      )
  )}
</nav>
