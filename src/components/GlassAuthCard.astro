---
/** 09 · Auth card — inputs are recessed rather than raised. Exactly one filled
 *  control, and it is the primary action.
 *
 *  The slot takes the fields (labelled <input>s are styled for you). `action`
 *  is the submit button's label and `formAction` the URL the form posts to
 *  (the current URL when omitted). While a valid form submits, the button
 *  shows a spinner — `busyLabel` swaps its text too — so it cannot be sent
 *  twice; invalid fields get aria-invalid.
 */
import './GlassAuthCard.css';
import { uid } from '../behaviors/core.js';

interface Props {
  title: string;
  /** The submit button's label. */
  action?: string;
  alt?: string;
  method?: string;
  formAction?: string;
  subtitle?: string;
  busyLabel?: string;
  theme?: 'light' | 'dark';
  material?: 'glass' | 'surface';
  class?: string;
}
const {
  title,
  action = 'Continue',
  alt,
  method = 'post',
  formAction,
  subtitle,
  busyLabel,
  theme,
  material = 'glass',
  class: cls = '',
} = Astro.props;
const titleId = uid('rw-auth');
---
<form
  class:list={['rw-auth', material === 'surface' ? 'rw-surface' : 'rw-glass', cls]}
  method={method}
  action={formAction}
  aria-labelledby={titleId}
  data-theme={theme}
  data-rw-auth
>
  <h2 class="rw-auth__title" id={titleId}>{title}</h2>
  {subtitle && <p class="rw-auth__sub">{subtitle}</p>}
  <slot />
  <button type="submit" class="rw-auth__go" data-busy-label={busyLabel}>{action}</button>
  {alt && <p class="rw-auth__alt">{alt}</p>}
  <slot name="footer" />
</form>

<script>
  import { onReady } from '../behaviors/core.js';
  import { initAuth } from '../behaviors/auth.js';
  onReady(initAuth);
</script>
