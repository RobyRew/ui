---
/** Avatar — a person's picture, or their initials on a tint.
 *
 *  The tint comes from the name (avatarHue: eight low-chroma tints in
 *  tokens.css), so one person keeps one colour everywhere; the size is
 *  data-size. Both are attributes — no inline style — so a strict CSP holds.
 *  A picture that fails to load falls back to the initials (initAvatars).
 *  Decorative by default (alt=""), since a name is usually beside it; pass
 *  `alt` when the avatar stands alone.
 */
import Icon from './Icon.astro';
import { avatarHue, initials } from '../behaviors/people.js';

interface Props {
  /** The name or @handle: the initials and the tint come from it. */
  name?: string;
  src?: string | null;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  /** 0–7, to pin a tint instead of deriving it. */
  hue?: number;
  alt?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { name = '', src, size = 'md', alt, loading = 'lazy', class: cls } = Astro.props;
const PX = { xs: 20, sm: 24, md: 32, lg: 40, xl: 56, '2xl': 80 } as const;
const hue = Astro.props.hue ?? (name ? avatarHue(name) : undefined);
const text = name ? initials(name) : '';
const dataSize = size === 'md' ? undefined : size;
---
{src ? (
  <img
    class:list={['rw-avatar', cls]}
    src={src}
    alt={alt ?? ''}
    width={PX[size]}
    height={PX[size]}
    loading={loading}
    decoding="async"
    referrerpolicy="no-referrer"
    data-size={dataSize}
    data-hue={hue}
    data-initials={text || undefined}
  />
) : text ? (
  <span
    class:list={['rw-avatar', cls]}
    data-size={dataSize}
    data-hue={hue}
    role={alt ? 'img' : undefined}
    aria-label={alt || undefined}
    aria-hidden={alt ? undefined : 'true'}
  >{text}</span>
) : (
  <span class:list={['rw-avatar', cls]} data-size={dataSize} aria-hidden="true"><Icon name="contact" /></span>
)}

<script>
  import { onReady } from '../behaviors/core.js';
  import { initAvatars } from '../behaviors/people.js';
  onReady(initAvatars);
</script>
