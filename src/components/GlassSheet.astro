---
/** 07 · Sheet — bottom sheet. Radius on the top corners only; anchored to the
 *  edge rather than floating, which is what distinguishes it from a card.
 *
 *  Inline by default: a section in the page flow (a specimen, or a panel the
 *  page shows and hides itself). With `modal` it is a real <dialog>: open it
 *  with <button commandfor={id} command="show-modal"> or openSheet(id); it
 *  docks to the bottom edge on phones (drag it down to dismiss) and becomes a
 *  centred form sheet on wider screens. It closes on Escape, the close button,
 *  a backdrop click, or the action button — whose dialog returnValue is
 *  "confirm" (the others give "cancel"); listen for the dialog's `close`
 *  event to act on it.
 */
import './GlassSheet.css';
import { uid } from '../behaviors/core.js';

interface Props {
  title: string;
  /** Label of the primary action button. */
  action?: string;
  modal?: boolean;
  /** Required to open a modal sheet by id; generated when omitted. */
  id?: string;
  /** Modal only: render open (the script promotes it to a modal on load). */
  open?: boolean;
  /** Modal only: false removes Escape, backdrop click, drag and the close button. */
  dismissible?: boolean;
  /** Modal only: medium is at least half the viewport, large nearly all of it. */
  size?: 'auto' | 'medium' | 'large';
  labels?: { close?: string };
  theme?: 'light' | 'dark';
  material?: 'glass' | 'surface';
  class?: string;
}
const {
  title,
  action,
  modal = false,
  id = uid('rw-sheet'),
  open = false,
  dismissible = true,
  size = 'auto',
  labels = {},
  theme,
  material = 'glass',
  class: cls = '',
} = Astro.props;
const surface = material === 'surface' ? 'rw-surface' : 'rw-glass';
const titleId = `${id}-title`;
---
{modal ? (
  <dialog
    id={id}
    class:list={['rw-sheet', surface, size !== 'auto' && `rw-sheet--${size}`, cls]}
    aria-labelledby={titleId}
    open={open || undefined}
    data-theme={theme}
    data-rw-sheet
    data-rw-dismissible={dismissible ? undefined : 'false'}
  >
    <div class="rw-sheet__drag" data-rw-sheet-drag={dismissible ? '' : undefined}>
      <span class="rw-sheet__grab" aria-hidden="true"></span>
      <div class="rw-sheet__head">
        <h2 class="rw-sheet__title" id={titleId}>{title}</h2>
        {dismissible && (
          <form method="dialog" class="rw-sheet__close-form">
            <button type="submit" value="cancel" class="rw-sheet__close rw-gl" aria-label={labels.close ?? 'Close'}>✕</button>
          </form>
        )}
      </div>
    </div>
    <div class="rw-sheet__body"><slot /></div>
    {action && (
      <form method="dialog" class="rw-sheet__foot">
        <button type="submit" value="confirm" class="rw-sheet__cta">{action}</button>
      </form>
    )}
  </dialog>
) : (
  <section class:list={['rw-sheet', surface, cls]} aria-labelledby={titleId} id={Astro.props.id} data-theme={theme}>
    <span class="rw-sheet__grab" aria-hidden="true"></span>
    <h2 class="rw-sheet__title" id={titleId}>{title}</h2>
    <div class="rw-sheet__body"><slot /></div>
    {action && <button type="button" class="rw-sheet__cta">{action}</button>}
  </section>
)}

<script>
  import { onReady } from '../behaviors/core.js';
  import { initSheets } from '../behaviors/sheet.js';
  onReady(initSheets);
</script>
