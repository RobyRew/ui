---
/** 07 · Sheet — bottom sheet. Radius on the top corners only; anchored to the
 *  edge rather than floating, which is what distinguishes it from a card. */
interface Props { title: string; action?: string; class?: string }
const { title, action, class: cls = '' } = Astro.props;
---
<section class:list={['rw-sheet', 'rw-glass', cls]} role="dialog" aria-modal="true" aria-label={title}>
  <span class="rw-sheet__grab" aria-hidden="true"></span>
  <h2 class="rw-sheet__title">{title}</h2>
  <div class="rw-sheet__body"><slot /></div>
  {action && <button type="button" class="rw-sheet__cta">{action}</button>}
</section>

<style>
  .rw-sheet { --r: 26px 26px 0 0; border-radius: 26px 26px 0 0; padding: 12px 16px 18px;
    display: flex; flex-direction: column; gap: 11px; }
  .rw-sheet__grab { width: 36px; height: 4px; border-radius: 99px; background: rgb(var(--rim-rgb) / .34); align-self: center; }
  .rw-sheet__title { margin: 0; font-size: 1.1rem; font-weight: 700; letter-spacing: -.015em; color: var(--g-ink); }
  .rw-sheet__body { font-size: .82rem; color: var(--g-ink-dim); line-height: 1.5; }
  .rw-sheet__cta { margin-top: 2px; font: 700 .82rem/1 var(--g-font); color: var(--g-ink); cursor: pointer;
    padding: 12px; border: 0; border-radius: 14px; background: rgb(var(--rim-rgb) / .2);
    box-shadow: inset 0 0 0 1px rgb(var(--rim-rgb) / .22); }
  .rw-sheet__cta:focus-visible { outline: 2px solid var(--g-ink); outline-offset: 2px; }
</style>
