---
/** 01 · Command bar — the site navbar. Widest, lowest density.
 *
 *  Below its collapse width the links fold into a menu: a popover opened by a
 *  glyph button, so it opens, light-dismisses and closes on Escape with no
 *  script. `collapse` names the bar width that triggers it — sm 30rem, md 40rem
 *  (default), lg 52rem — or "always" / "never". On a watch-sized bar (under
 *  18rem) the action moves into the menu too, and the `end` slot is hidden in
 *  favour of the `menu` slot, which renders at the bottom of the menu.
 *
 *  The bar fills its container's width. Pass `fit` for a pill that shrink-wraps
 *  its content instead; a fitted bar never collapses.
 */
import './GlassBar.css';
import { uid } from '../behaviors/core.js';

export interface Link { label: string; href: string; current?: boolean }
interface Props {
  links: Link[];
  brandHref?: string;
  /** The trailing call to action. `primary` fills it with the accent. */
  action?: { label: string; href: string; primary?: boolean };
  /** Shown right-aligned as a hint, e.g. "⌘K". Plain text, no icon font.
   *  Hidden on touch-only devices, which have no keyboard to press it on. */
  hint?: string;
  collapse?: 'never' | 'sm' | 'md' | 'lg' | 'always';
  fit?: boolean;
  /** Accessible names, for pages that are not in English. */
  labels?: { nav?: string; home?: string; menu?: string };
  /** Pin this bar (and its menu) to one theme, whatever the page uses. */
  theme?: 'light' | 'dark';
  /** "surface" draws the same bar opaque, for use as content. */
  material?: 'glass' | 'surface';
  class?: string;
}
const {
  links,
  brandHref = '/',
  action,
  hint,
  collapse = 'md',
  fit = false,
  labels = {},
  theme,
  material = 'glass',
  class: cls = '',
} = Astro.props;
const surface = material === 'surface' ? 'rw-surface' : 'rw-glass';
const collapsible = !fit && collapse !== 'never' && (links.length > 0 || !!action);
const menuId = uid('rw-bar-menu');
const hasBrand = Astro.slots.has('brand');
const hasEnd = Astro.slots.has('end');
const hasMenu = Astro.slots.has('menu');
---
<nav
  class:list={['rw-bar', surface, collapsible && `rw-bar--collapse-${collapse}`, { 'rw-bar--fit': fit }, cls]}
  aria-label={labels.nav ?? 'Primary'}
  data-theme={theme}
  data-rw-bar
>
  <a class="rw-bar__brand" href={brandHref} aria-label={labels.home ?? 'Home'}>
    {hasBrand ? <slot name="brand" /> : <span class="rw-bar__mark" aria-hidden="true"></span>}
  </a>
  {links.length > 0 && (
    <ul class="rw-bar__links">
      {links.map((l) => (
        <li>
          <a href={l.href} class:list={['rw-bar__link', { 'is-current': l.current }]}
             aria-current={l.current ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  )}
  {hasEnd && <div class="rw-bar__end"><slot name="end" /></div>}
  {hint && <kbd class="rw-bar__hint rw-gl" aria-hidden="true">{hint}</kbd>}
  {action && (
    <a class:list={['rw-bar__action', { 'rw-bar__action--primary': action.primary }]} href={action.href}>{action.label}</a>
  )}
  {collapsible && (
    <button type="button" class="rw-bar__toggle" popovertarget={menuId} aria-label={labels.menu ?? 'Menu'}>
      <span class="rw-bar__burger" aria-hidden="true"><i></i><i></i></span>
    </button>
  )}
  {collapsible && (
    <div id={menuId} popover class:list={['rw-bar__menu', surface]} data-rw-bar-menu>
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      {action && <a class="rw-bar__menu-action" href={action.href}>{action.label}</a>}
      {hasMenu && <div class="rw-bar__menu-extra"><slot name="menu" /></div>}
    </div>
  )}
</nav>

<script>
  import { onReady } from '../behaviors/core.js';
  import { initBars } from '../behaviors/bar.js';
  onReady(initBars);
</script>
