---
/** 06 · Inset list — grouped rows, hairlines inset from the edge. Densest text
 *  format. A row with `href` is a link (chevron, hover and press); without one
 *  it is a static label/value pair. `detail` adds a second line; `external`
 *  opens the link in a new tab and says so to screen readers.
 */
import './GlassList.css';

export interface Row {
  glyph?: string;
  label: string;
  value?: string;
  href?: string;
  detail?: string;
  current?: boolean;
  external?: boolean;
}
interface Props {
  rows: Row[];
  labels?: { external?: string };
  theme?: 'light' | 'dark';
  material?: 'glass' | 'surface';
  class?: string;
}
const { rows, labels = {}, theme, material = 'glass', class: cls = '' } = Astro.props;
---
<ul class:list={['rw-list', material === 'surface' ? 'rw-surface' : 'rw-glass', cls]} role="list" data-theme={theme}>
  {rows.map((r) => {
    const Tag = r.href ? 'a' : 'span';
    return (
      <li>
        <Tag
          href={r.href}
          class:list={['rw-list__row', { 'is-current': r.current }]}
          aria-current={r.current ? 'page' : undefined}
          target={r.href && r.external ? '_blank' : undefined}
          rel={r.href && r.external ? 'noopener' : undefined}
        >
          {r.glyph && <span class="rw-list__icon rw-gl" aria-hidden="true">{r.glyph}</span>}
          <span class="rw-list__text">
            <span class="rw-list__label">{r.label}</span>
            {r.detail && <span class="rw-list__detail">{r.detail}</span>}
          </span>
          {r.value && <span class="rw-list__value">{r.value}</span>}
          {r.href && r.external && <span class="rw-sr-only">{labels.external ?? '(opens in a new tab)'}</span>}
          {r.href && <span class="rw-list__chev rw-gl" aria-hidden="true">{r.external ? '↗' : '›'}</span>}
        </Tag>
      </li>
    );
  })}
</ul>
