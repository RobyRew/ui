---
/** 10 · Toast — shortest and widest. Tightest radius in the set: a transient
 *  strip should not read as a card. */
interface Props { title: string; detail?: string; tone?: 'ok' | 'warn' | 'error';
  action?: { label: string; href: string }; dismissible?: boolean; class?: string }
const { title, detail, tone = 'ok', action, dismissible = true, class: cls = '' } = Astro.props;
const glyph = { ok: '✓', warn: '⚠', error: '✕' }[tone];
---
<div class:list={['rw-toast', 'rw-glass', cls]} role="status" aria-live="polite">
  <span class:list={['rw-toast__icon', tone, 'rw-gl']} aria-hidden="true">{glyph}</span>
  <p class="rw-toast__msg"><b>{title}</b>{detail && <span> {detail}</span>}</p>
  <span class="rw-toast__act">
    {action && <a href={action.href}>{action.label}</a>}
    {dismissible && <button type="button" class="rw-gl" aria-label="Dismiss">✕</button>}
  </span>
</div>

<style>
  .rw-toast { --r: 16px; display: flex; align-items: center; gap: 12px; padding: 12px 14px; }
  .rw-toast__icon { width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center;
    font-size: .85rem; flex: 0 0 auto; }
  .rw-toast__icon.ok { background: rgb(110 231 168 / .18); color: #6ee7a8; }
  .rw-toast__icon.warn { background: rgb(255 200 100 / .18); color: #ffc864; }
  .rw-toast__icon.error { background: rgb(255 143 143 / .18); color: #ff8f8f; }
  .rw-toast__msg { margin: 0; font-size: .8rem; color: var(--g-ink); min-width: 0; }
  .rw-toast__msg span { color: var(--g-ink-dim); }
  .rw-toast__act { margin-left: auto; display: flex; gap: 7px; align-items: center; }
  .rw-toast__act a, .rw-toast__act button { font-size: .7rem; font-weight: 700; color: var(--g-ink);
    text-decoration: none; padding: 6px 11px; border-radius: 9px; border: 0; cursor: pointer;
    background: rgb(var(--rim-rgb) / .15); font-family: inherit; }
  .rw-toast__act a:focus-visible, .rw-toast__act button:focus-visible { outline: 2px solid var(--g-ink); outline-offset: 2px; }
</style>
