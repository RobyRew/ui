---
/** 10 · Toast — shortest and widest. Tightest radius in the set: a transient
 *  strip should not read as a card.
 *
 *  Rendered in the page it is a static notice (a flash message after a
 *  redirect, say). Wrap it in <div class="rw-toaster"> to float it at the top
 *  of the viewport instead. The dismiss button removes it with an exit
 *  animation; `timeout` (ms) dismisses it on its own, pausing while it is
 *  hovered or focused; on touch it can be swiped away. To raise one from
 *  script, use toast() from '@robyrew/ui/behaviors.js' — same markup.
 */
import './GlassToast.css';

interface Props {
  title: string;
  detail?: string;
  tone?: 'ok' | 'warn' | 'error' | 'info';
  action?: { label: string; href: string };
  dismissible?: boolean;
  /** Auto-dismiss after this many milliseconds. */
  timeout?: number;
  labels?: { dismiss?: string };
  theme?: 'light' | 'dark';
  material?: 'glass' | 'surface';
  class?: string;
}
const {
  title,
  detail,
  tone = 'ok',
  action,
  dismissible = true,
  timeout,
  labels = {},
  theme,
  material = 'glass',
  class: cls = '',
} = Astro.props;
const glyph = { ok: '✓', warn: '⚠', error: '✕', info: 'ⓘ' }[tone];
const surface = material === 'surface' ? 'rw-surface' : 'rw-glass';
---
<div
  class:list={['rw-toast', surface, `rw-toast--${tone}`, cls]}
  role={tone === 'error' ? 'alert' : 'status'}
  aria-live={tone === 'error' ? 'assertive' : 'polite'}
  data-theme={theme}
  data-rw-toast
  data-rw-timeout={timeout}
  data-rw-dismissible={dismissible ? undefined : 'false'}
>
  <span class:list={['rw-toast__icon', tone, 'rw-gl']} aria-hidden="true">{glyph}</span>
  <p class="rw-toast__msg"><b>{title}</b>{detail && <span> {detail}</span>}</p>
  {(action || dismissible) && (
    <span class="rw-toast__act">
      {action && <a href={action.href}>{action.label}</a>}
      {dismissible && <button type="button" class="rw-gl" aria-label={labels.dismiss ?? 'Dismiss'} data-rw-dismiss>✕</button>}
    </span>
  )}
</div>

<script>
  import { onReady } from '../behaviors/core.js';
  import { initToasts } from '../behaviors/toast.js';
  onReady(initToasts);
</script>
