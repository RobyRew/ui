---
/** 03 · HUD — smallest and densest. Transient overlay; the one place a large
 *  radius on a small box reads correctly.
 *
 *  Inline it shows a level. With `overlay` it floats in the middle of the
 *  viewport, hidden until showHud(id, { value }) from
 *  '@robyrew/ui/behaviors.js' raises it — a volume or brightness change.
 */
import './pct.css';
import './GlassHud.css';

interface Props {
  glyph: string;
  caption: string;
  value: number;
  overlay?: boolean;
  id?: string;
  theme?: 'light' | 'dark';
  material?: 'glass' | 'surface';
  class?: string;
}
const { glyph, caption, value, overlay = false, id, theme, material = 'glass', class: cls = '' } = Astro.props;
const pct = Math.round(Math.max(0, Math.min(100, value)));
---
<div
  class:list={['rw-hud', material === 'surface' ? 'rw-surface' : 'rw-glass', { 'rw-hud--overlay': overlay }, cls]}
  id={id}
  role="status"
  aria-live="polite"
  data-theme={theme}
>
  <span class="rw-hud__glyph rw-gl" aria-hidden="true">{glyph}</span>
  <div class="rw-hud__track" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100" aria-label={caption}>
    <div class="rw-hud__fill" data-pct={pct}></div>
  </div>
  <span class="rw-hud__cap">{caption}</span>
</div>
