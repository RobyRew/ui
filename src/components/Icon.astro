---
/** An icon from @robyrew/ui/icons, rendered at build time. Decorative unless
 *  `label` is given (then role="img" with that name) — label the control that
 *  holds a decorative icon instead. */
import { ICON_PATHS, type IconName } from '../icons.js';

interface Props {
  name: IconName;
  /** Pixels; default 18. */
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 18, label, class: cls } = Astro.props;
---
<svg
  class:list={['rw-icon', cls]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  focusable="false"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={ICON_PATHS[name] ?? ''}
/>
