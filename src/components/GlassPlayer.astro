---
/** 04 · Player — media format. The artwork is opaque and sits UNDER the glass:
 *  content layer, never glass on glass.
 *
 *  Give it `media` — a selector for an <audio> or <video> on the page — and it
 *  drives that element: play/pause, scrubbing (`seekable`), elapsed and
 *  remaining time, and the system Now Playing controls (lock screen, Control
 *  Center, a paired watch) through the Media Session API. Without `media` the
 *  buttons dispatch rw:play / rw:pause / rw:prev / rw:next / rw:seek on the
 *  player for the page to handle.
 */
import './pct.css';
import './GlassPlayer.css';

interface Props {
  title: string;
  subtitle?: string;
  progress?: number;
  artwork?: string;
  playing?: boolean;
  media?: string;
  seekable?: boolean;
  labels?: { previous?: string; next?: string; play?: string; pause?: string; progress?: string };
  theme?: 'light' | 'dark';
  material?: 'glass' | 'surface';
  class?: string;
}
const {
  title,
  subtitle,
  progress = 0,
  artwork,
  playing = true,
  media,
  seekable = false,
  labels = {},
  theme,
  material = 'glass',
  class: cls = '',
} = Astro.props;
const pct = Math.round(Math.max(0, Math.min(100, progress)));
const L = {
  previous: labels.previous ?? 'Previous',
  next: labels.next ?? 'Next',
  play: labels.play ?? 'Play',
  pause: labels.pause ?? 'Pause',
  progress: labels.progress ?? 'Progress',
};
---
<div
  class:list={['rw-player', material === 'surface' ? 'rw-surface' : 'rw-glass', { 'is-playing': playing }, cls]}
  data-theme={theme}
  data-media={media}
  data-rw-player
>
  <div class="rw-player__art" aria-hidden="true">
    {artwork && <img src={artwork} alt="" loading="lazy" decoding="async" />}
  </div>
  <div class="rw-player__meta">
    <p class="rw-player__title">{title}</p>
    {subtitle && <p class="rw-player__sub">{subtitle}</p>}
    {seekable ? (
      <input type="range" class="rw-player__seek" min="0" max="100" step="0.1" value={pct} data-pct={pct} aria-label={L.progress} />
    ) : (
      <div class="rw-player__bar" role="progressbar" aria-valuenow={pct} aria-valuemin="0" aria-valuemax="100" aria-label={L.progress}>
        <i data-pct={pct}></i>
      </div>
    )}
    {media && (
      <div class="rw-player__time" aria-hidden="true"><span data-rw-elapsed>0:00</span><span data-rw-remaining></span></div>
    )}
  </div>
  <div class="rw-player__transport">
    <button type="button" class="rw-gl" aria-label={L.previous} data-rw-cmd="prev">⏮</button>
    <button type="button" class="rw-gl rw-player__play" aria-label={playing ? L.pause : L.play}
            data-rw-cmd="toggle" data-label-play={L.play} data-label-pause={L.pause}>{playing ? '⏸' : '⏵'}</button>
    <button type="button" class="rw-gl" aria-label={L.next} data-rw-cmd="next">⏭</button>
  </div>
</div>

<script>
  import { onReady } from '../behaviors/core.js';
  import { initPlayers } from '../behaviors/player.js';
  onReady(initPlayers);
</script>
