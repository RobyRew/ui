---
/** 05 · Stat tile — number-led. Square, big figure, sparkline.
 *
 *  The figure scales with the tile's own width. The trend arrow is announced
 *  in words (labels.up / labels.down), not left to a glyph. With `href` the
 *  whole tile is a link and lifts on hover.
 */
import './pct.css';
import './GlassTile.css';

interface Props {
  label: string;
  value: string;
  delta?: string;
  trend?: 'up' | 'down' | 'flat';
  spark?: number[];
  href?: string;
  labels?: { up?: string; down?: string; flat?: string; spark?: string };
  theme?: 'light' | 'dark';
  material?: 'glass' | 'surface';
  class?: string;
}
const {
  label,
  value,
  delta,
  trend = 'up',
  spark = [],
  href,
  labels = {},
  theme,
  material = 'glass',
  class: cls = '',
} = Astro.props;
const max = Math.max(1, ...spark);
const glyph = { up: '▲', down: '▼', flat: '▬' }[trend];
const trendWord = { up: labels.up ?? 'up', down: labels.down ?? 'down', flat: labels.flat ?? 'unchanged' }[trend];
const Tag = href ? 'a' : 'article';
---
<Tag
  class:list={['rw-tile', material === 'surface' ? 'rw-surface' : 'rw-glass', { 'rw-tile--link': href }, cls]}
  href={href}
  data-theme={theme}
>
  <span class="rw-tile__label">{label}</span>
  <span class="rw-tile__value">{value}</span>
  {delta && (
    <span class:list={['rw-tile__delta', trend]}>
      <span class="rw-gl" aria-hidden="true">{glyph}</span><span class="rw-sr-only">{trendWord} </span>{delta}
    </span>
  )}
  <slot />
  {spark.length > 0 && (
    <div class="rw-tile__spark" role="img" aria-label={`${labels.spark ?? 'Trend'}: ${spark.join(', ')}`}>
      {spark.map((n, i) => (
        <i data-pct={Math.round((Math.max(0, n) / max) * 100)} class:list={{ last: i === spark.length - 1 }}></i>
      ))}
    </div>
  )}
</Tag>
